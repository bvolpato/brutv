set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{PS5_PAYLOAD_SDK})
  message(FATAL_ERROR "Run tools/build-ps5.sh so the pinned SDK is selected")
endif()
set(PS5_PAYLOAD_SDK "$ENV{PS5_PAYLOAD_SDK}" CACHE PATH "Pinned public payload SDK")
set(CMAKE_C_COMPILER clang-18)
set(CMAKE_CXX_COMPILER clang++-18)
set(CMAKE_AR llvm-ar-18)
set(CMAKE_RANLIB llvm-ranlib-18)
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_SYSROOT "${PS5_PAYLOAD_SDK}")
set(_ps5_flags "-fvisibility-nodllstorageclass=default -fno-stack-protector -fno-plt -femulated-tls -ffunction-sections -fdata-sections")
set(CMAKE_C_FLAGS_INIT "${_ps5_flags} -isystem ${PS5_PAYLOAD_SDK}/target/include")
set(CMAKE_CXX_FLAGS_INIT "${_ps5_flags} -fexceptions -fcxx-exceptions -isystem ${PS5_PAYLOAD_SDK}/target/include/c++/v1 -isystem ${PS5_PAYLOAD_SDK}/target/include")
set(CMAKE_EXE_LINKER_FLAGS_INIT "")
set(CMAKE_CXX_LINK_EXECUTABLE "bash ${CMAKE_CURRENT_LIST_DIR}/../tools/ps5-link.sh <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
set(CMAKE_C_LINK_EXECUTABLE "${CMAKE_CXX_LINK_EXECUTABLE}")
set(CMAKE_SKIP_RPATH TRUE)
set(CMAKE_FIND_ROOT_PATH "${PS5_PAYLOAD_SDK}/target" "$ENV{BRUTV_PS5_PACBREW}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
set(BRUTV_PS5 ON CACHE BOOL "Build the native PlayStation 5 title")
