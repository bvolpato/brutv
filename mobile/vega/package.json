{
  "name": "brutv-vega",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18 <23"
  },
  "scripts": {
    "test": "tsc -p tsconfig.domain.json && node --test build-domain/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "setup:shaka": "bash scripts/build-shaka.sh",
    "build:debug": "react-native build-kepler --build-type Debug",
    "build:release": "react-native build-kepler --build-type Release",
    "build:app": "npm run build:release && npm run build:debug"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "2.0.9000000000",
    "@amazon-devices/react-native-w3cmedia": "2.1.99",
    "@xmldom/xmldom": "0.9.12",
    "@babel/runtime": "7.29.10",
    "base-64": "1.0.0",
    "fastestsmallesttextencoderdecoder": "1.0.22",
    "react": "18.2.0",
    "react-native": "0.72.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "0.22.14",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@react-native-community/cli": "11.3.2",
    "@react-native/metro-config": "0.72.6",
    "@types/node": "18.19.130",
    "@types/react": "18.2.75",
    "metro-react-native-babel-preset": "0.76.9",
    "typescript": "4.9.5"
  },
  "kepler": {
    "projectType": "application",
    "appName": "BruTV",
    "targets": [
      "tv"
    ],
    "os": [
      "vega"
    ],
    "api": 0.1
  }
}
