{
  "name": "brutv-vega",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.17.0 <23",
    "npm": ">=11.21.0"
  },
  "scripts": {
    "postinstall": "npm run setup:all",
    "test": "npm run setup:all && tsc -p tsconfig.domain.json && node --test build-domain/test/*.test.js test/tooling.test.cjs",
    "typecheck": "tsc --noEmit",
    "setup:shaka": "bash scripts/build-shaka.sh",
    "setup:metro": "node scripts/patch-metro.cjs",
    "setup:deepmerge": "node scripts/patch-deepmerge.cjs",
    "setup:all": "npm run setup:metro && npm run setup:deepmerge",
    "bundle": "npm run setup:all && react-native bundle",
    "build:debug": "npm run setup:all && react-native build-kepler --build-type Debug",
    "build:release": "npm run setup:all && react-native build-kepler --build-type Release",
    "build:app": "npm run build:release && npm run build:debug"
  },
  "dependencies": {
    "@amazon-devices/kepler-file-system": "0.0.7",
    "@amazon-devices/react-native-kepler": "4.0.1",
    "@amazon-devices/react-native-w3cmedia": "2.3.2",
    "@babel/runtime": "8.0.8",
    "@xmldom/xmldom": "0.9.12",
    "base-64": "1.0.0",
    "fastestsmallesttextencoderdecoder": "1.0.22",
    "react": "19.3.1",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "0.22.14",
    "@babel/core": "8.0.9",
    "@babel/plugin-transform-react-jsx": "8.0.1",
    "@react-native-community/cli": "11.4.1",
    "@react-native/metro-config": "0.88.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "metro-react-native-babel-preset": "0.77.0",
    "typescript": "7.0.2"
  },
  "kepler": {
    "projectType": "application",
    "appName": "BruTV",
    "targets": [
      "tv"
    ],
    "os": [
      "vega"
    ],
    "api": 0.1
  },
  "overrides": {
    "@react-native-community/cli": "$@react-native-community/cli",
    "fast-xml-parser": "5.7.0",
    "image-size": "2.0.3",
    "joi": "17.13.9",
    "lodash": "4.18.1",
    "toml": "5.0.1"
  }
}
